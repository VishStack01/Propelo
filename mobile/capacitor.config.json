{
  "appId": "org.propelo.app",
  "appName": "Propelo",
  "webDir": "www",
  "server": {
    "url": "https://app.propelo.org",
    "cleartext": false,
    "errorPath": "offline.html"
  },
  "android": {
    "appendUserAgent": "PropeloApp/1.0 (Android)",
    "allowMixedContent": false,
    "backgroundColor": "#FAF3E6"
  },
  "ios": {
    "appendUserAgent": "PropeloApp/1.0 (iOS)",
    "backgroundColor": "#FAF3E6",
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  }
}
