# Propelo: bring your own model.
# Copy this file to .env (it is git-ignored) and fill in ONE provider.
# Propelo reads it when you run any `propelo` command from this folder.
# Your key stays on your machine: it is sent only to the provider you choose.

# anthropic | openai | gemini | ollama
PROPELO_LLM=anthropic

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI, or any OpenAI-compatible API (OpenRouter, Groq, Together, a local vLLM...)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
# GEMINI_API_KEY=

# Ollama: free and fully local, no key
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional: pin models (defaults are picked per provider)
# PROPELO_MODEL=
# PROPELO_MODEL_QUICK=

# ======================================================================
# Optional: Propelo Cloud (the multi-user service, docker compose)
# ======================================================================

# --- Database (docker compose builds DATABASE_URL from this password) ---
POSTGRES_PASSWORD=CHANGE_ME_to_a_long_random_password

# --- Where the app runs ---
# development: SQLite or Postgres, emails printed to the log, migrations applied automatically.
# staging / production: requires PostgreSQL, an https PUBLIC_URL and SMTP; run `propelo cloud migrate` as a release step.
APP_ENV=development
PUBLIC_URL=http://127.0.0.1:8000
# Set to 1 only behind a reverse proxy you control (the caddy profile, Render, Fly).
TRUST_PROXY=0
# One small server instead of three services: serve also migrates and runs the worker. Uploads in the database.
# ALL_IN_ONE=on
# STORAGE=db

# --- Email (sign-up confirmation, password reset) ---
# smtp://user:password@smtp.example.com:587 (STARTTLS) or smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Propelo <no-reply@example.com>

# --- Accounts ---
# The first account with this email becomes the operator (sees /api/admin/overview).
BOOTSTRAP_ADMIN_EMAIL=
# open | allowlist | closed. For a private beta use allowlist with emails or @domains.
SIGNUP_MODE=open
# Optional "Continue with LinkedIn" (Sign in with LinkedIn using OpenID Connect): name, email and photo only.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Sign in with a mobile number (Twilio Verify). A member adds a number in Settings, then signs in with a texted code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
# Sign in with GitHub (name and confirmed email only). Callback: <PUBLIC_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Sign in with Google uses GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET. Add the redirect <PUBLIC_URL>/api/auth/google/callback to that client.
SIGNUP_ALLOWLIST=
SESSION_TTL_DAYS=14

# --- Plans, payments and the hosted AI allowance ---
# Encrypts users' own model keys at rest. Required in production: any random string of 32+ characters.
SECRETS_KEY=
# Shown on the policy pages and pricing. Payment providers need a working support address.
SUPPORT_EMAIL=
COMPANY_NAME=Propelo
# Member prices are in US dollars (cents). Dodo charges each buyer in their own currency.
PRO_PRICE_USD_CENTS=3900
ULTRA_PRICE_USD_CENTS=7900
FREE_AI_CREDITS=15
PRO_AI_CREDITS=400
ULTRA_AI_CREDITS=1500
# The service's own model for the monthly AI allowance uses PROPELO_LLM and the provider key at the top of this file.
# Member payments: Dodo Payments (Developer > API keys, Products, Developer > Webhooks), the merchant of record.
# Webhook URL: https://YOUR-DOMAIN/api/billing/dodo-webhook. DODO_MODE is test or live.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_PRO=
DODO_PRODUCT_ULTRA=
DODO_MODE=test
# Optional: rupee payment links for consultancies and agencies in India (Razorpay: Settings > API keys, Webhooks).
# Webhook URL: https://YOUR-DOMAIN/api/billing/webhook. Members never pay through Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Automatic recruiter emails from users' own Gmail (Google Cloud console > APIs > Credentials > OAuth client, web).
# Redirect URI: https://YOUR-DOMAIN/api/mailbox/google/callback. Scope used: gmail.send only. Needs SECRETS_KEY.
# Google must verify the app before people outside your test users can connect (see docs/launch.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Files ---
MAX_UPLOAD_MB=5
USER_STORAGE_MB=25

# --- Job inventory ---
# The hourly scan's public feed (the feed-latest release). Point at your fork's release if you run your own scan.
FEED_URL=https://github.com/VishStack01/Propelo/releases/download/feed-latest/
INGEST_EVERY_MINUTES=15

# --- Concierge (the Job Guarantee): retired with the move to the US, UK, Ireland and the Netherlands ---
# A talent partner ran the search in India for a fee after joining. Leave it off: the website, pricing and terms no
# longer offer it, and turning it on also needs its terms put back on /terms. Kept for anyone running their own copy.
CONCIERGE=off
CONCIERGE_COUNTRIES=IN
# 8% of yearly fixed pay up to the band, 6% above it; tax (GST) added on top when you're registered.
CONCIERGE_RATE_LOW=8
CONCIERGE_RATE_HIGH=6
CONCIERGE_BAND=2000000
CONCIERGE_TAX_RATE=0
CONCIERGE_INSTALMENTS=3
CONCIERGE_ATTRIBUTION_DAYS=180

# --- The Interview Guarantee: money back, never a promised job (see /terms#guarantees) ---
# For Pro and Ultra members, by application: the team reviews each one at /staff. Not part of any plan.
# Once accepted, paid once; fewer than GUARANTEE_MIN_INTERVIEWS (3) interviews and no second round in GUARANTEE_DAYS, with the activity done, the price back.
GUARANTEE=off
GUARANTEE_DAYS=45
GUARANTEE_MIN_APPLICATIONS=25
GUARANTEE_MIN_WEEKS=3
# Advisory: shown to the reviewer, not a hard rule.
GUARANTEE_MIN_MATCHES=40
GUARANTEE_CLAIM_DAYS=30
# Paid through a one-time Dodo product priced at this amount ($59).
GUARANTEE_INTERVIEW_PRICE_USD_CENTS=5900
DODO_PRODUCT_GUARANTEE=

# --- Company logos in the app ---
# The public job board the app takes company logos from (each company's own icon, fetched by the Pages build).
JOBS_SITE_URL=https://propelo.org/

# --- Reliability and security ---
# A second model provider for the AI allowance, used once when the first fails (its key must be set above).
PROPELO_LLM_FALLBACK=
# Error reporting (pip install sentry-sdk). Only the error and route are sent: no bodies, cookies or user details.
SENTRY_DSN=
# Shown in /.well-known/security.txt (defaults to SUPPORT_EMAIL).
SECURITY_EMAIL=

# --- Tuning ---
DB_POOL_MIN=1
DB_POOL_MAX=10
WORKER_POLL_SECONDS=5

# 90-day passes: Pro ($99) or Ultra ($189) for PASS_DAYS, paid once, nothing renews. On unless PASS=off; each pass
# goes on sale once its one-time Dodo product exists, priced at PASS_PRICE_USD_CENTS or PASS_ULTRA_PRICE_USD_CENTS.
PASS=on
PASS_DAYS=90
PASS_PRICE_USD_CENTS=9900
PASS_ULTRA_PRICE_USD_CENTS=18900
DODO_PRODUCT_PASS=
DODO_PRODUCT_PASS_ULTRA=
