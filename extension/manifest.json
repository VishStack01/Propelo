{
  "manifest_version": 3,
  "name": "Propelo: autofill, match score and apply queue",
  "short_name": "Propelo",
  "version": "2.6.0",
  "description": "See how well each role matches your real resume, fill application forms from your Propelo profile, and work through your apply queue. You check every answer and press Submit yourself.",
  "action": {
    "default_title": "Propelo Autofill",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "minimum_chrome_version": "110",
  "background": {
    "service_worker": "background.js"
  }
}
